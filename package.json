{
  "name": "opencode-autoresearch",
  "version": "3.14.2",
  "description": "Autonomous recursive self-improvement engine for OpenCode and Hermes Agent. Subagent-first iteration loop with mechanical verification.",
  "author": {
    "name": "Maleick",
    "url": "https://github.com/Maleick"
  },
  "homepage": "https://github.com/Maleick/AutoResearch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maleick/AutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/Maleick/AutoResearch/issues"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "hermes",
    "plugin",
    "agent",
    "autoresearch",
    "automation",
    "workflows",
    "self-improvement",
    "iteration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "autoresearch": "dist/cli.js",
    "opencode-autoresearch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "hooks",
    "commands",
    "skills",
    "plugins/autoresearch.ts",
    "docs/ARCHITECTURE.md",
    "docs/autoresearch-loop.svg",
    "docs/CNAME",
    "docs/index.html",
    "docs/OPENCODE_INSTALL.md",
    "docs/QUICKSTART.md",
    "docs/RELEASE.md",
    "INSTALL.md",
    ".opencode/INSTALL.md",
    ".opencode-plugin",
    "AGENTS.md",
    "VERSION",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --runInBand",
    "verify:pack": "bash hooks/verify-package.sh",
    "prepack": "node scripts/sync-version.mjs && tsc"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "jest": "^30.3.0",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
